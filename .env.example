# Optional local defaults for repeat demos.
# You do NOT need this file to run the proof of concept.
# Auth is OAuth-only — there are no API keys to configure.

# ── CTM OAuth2 ───────────────────────────────────────────────────────────────
# Register an OAuth app at https://app.calltrackingmetrics.com/oauth_apps
# If omitted here, the app reads them from the macOS keychain
# (service "ctm-env": account "ctm_oauth_softphone", account "oauth_secret_id").
CTM_OAUTH_CLIENT_ID=
CTM_OAUTH_CLIENT_SECRET=
# Optional overrides (sensible defaults are built in):
# CTM_OAUTH_SCOPE=profile reports activity manage
#   NOTE: the phone embed's phone_access endpoint needs the "manage" scope;
#   without it you'll see a 403. manage also requires the authorizing user to
#   be an owner/admin on the account.
# CTM_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback

# CTM account ID (found in the CTM app URL) — used as a fallback if the OAuth
# token's account cannot be resolved automatically.
CTM_ACCOUNT_ID=11774

# Optional: enable the Account Assist chat widget
CTM_CHAT_TOKEN=

# Optional: left-rail ops feed sources
OPS_WEATHER_CITY=New York, NY
OPS_NEWS_FEED_URL=https://feeds.npr.org/1001/rss.xml

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret